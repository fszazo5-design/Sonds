{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "backend:start": "node backend/server.mjs",
    "backend:check": "node --check backend/server.mjs && node --check backend/worker.mjs && node --check backend/sync-core.mjs && node --check backend/media-core.mjs",
    "backend:test": "node --test backend/sync-core.test.mjs",
    "worker:test": "node --test backend/worker.test.mjs",
    "media:test": "node --test backend/media-core.test.mjs",
    "neon:upload-videos": "node scripts/import-neon-videos.mjs",
    "worker:check": "wrangler deploy --dry-run --outdir /tmp/sonds-worker-dist --config wrangler.toml"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "pg": "^8.23.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wrangler": "^4.149.0"
  }
}
