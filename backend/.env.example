# Server-only setting. Never copy this connection string into VITE_* variables or frontend code.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional. Defaults include Android WebView, this repository's GitHub Pages origin, and Vite localhost.
ALLOWED_ORIGINS=https://appassets.androidplatform.net,https://fszazo5-design.github.io,http://localhost:5173,http://127.0.0.1:5173

# Optional. The backend also reads PORT supplied by its eventual hosting provider.
PORT=8787
